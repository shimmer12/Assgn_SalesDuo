### Root gitignore for monorepo: ignores common OS, IDE, node, docker and build artifacts

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
dist/
build/
.turbo/
.tsbuildinfo

# Vite / Frontend
/.vite/
/.cache/
dist/

# Docker
docker-compose.override.yml
**/Dockerfile.local

# Environment
.env
.env.*

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Coverage and test output
coverage/
.nyc_output/

# Misc
.cache/
*.local

