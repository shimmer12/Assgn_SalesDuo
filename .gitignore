(# Root .gitignore - workspace-level ignore rules)
# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
logs/
*.log

# Runtime / build output
dist/
build/
coverage/
.cache/

# Environment files
.env
.env.local
.env.*.local

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Docker / local override files (don't ignore Dockerfile itself)
docker-compose.override.yml

# Misc
*.tgz

